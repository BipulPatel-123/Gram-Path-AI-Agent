# Copy to .env and edit for deployment.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
INTERNAL_PYTHON_PORT=8765
# Optional override. Windows tries py first.
# PYTHON_BIN=py
# Development admin defaults to enabled; in production it defaults to disabled.
# ENABLE_ADMIN=false
# Use a unique 32+ char secret only if you enable production admin endpoints.
# GRAMPATH_ADMIN_KEY=replace-with-at-least-32-random-characters
# Set true ONLY when Cloudflare Tunnel forwards to a localhost-only gateway.
CLOUDFLARE_TUNNEL=false
